{
  "AssessmentSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "unitId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "at": {
        "type": "number",
        "minimum": 0
      },
      "mode": {
        "type": "string",
        "enum": [
          "production",
          "cloze",
          "transfer",
          "dictation",
          "targeted"
        ]
      },
      "prompt": {
        "type": "string",
        "maxLength": 8000
      },
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "grade": {
        "type": "object",
        "properties": {
          "correct": {
            "type": "boolean"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "feedbackVi": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "correctedEn": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "errors": {
            "maxItems": 600,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "original": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "correction": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "reasonVi": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "article",
                    "tense_aspect",
                    "preposition",
                    "plural",
                    "word_order",
                    "agreement",
                    "word_choice",
                    "auxiliary",
                    "spelling",
                    "other"
                  ]
                },
                "l1NoteVi": {
                  "type": "string",
                  "maxLength": 3000
                }
              },
              "required": [
                "original",
                "correction",
                "reasonVi"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "correct",
          "score",
          "feedbackVi",
          "correctedEn",
          "errors"
        ],
        "additionalProperties": false
      },
      "origin": {
        "type": "string",
        "enum": [
          "ai",
          "dictation",
          "legacy"
        ]
      }
    },
    "required": [
      "id",
      "unitId",
      "at",
      "mode",
      "prompt",
      "answer",
      "grade",
      "origin"
    ],
    "additionalProperties": false
  },
  "UsageSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "at": {
        "type": "number",
        "minimum": 0
      },
      "day": {
        "type": "string"
      },
      "month": {
        "type": "string"
      },
      "model": {
        "type": "string",
        "maxLength": 100
      },
      "task": {
        "type": "string",
        "enum": [
          "analysis",
          "transcript",
          "grading",
          "explanation",
          "targeted",
          "weekly"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "started",
          "success",
          "failed"
        ]
      },
      "tokens": {
        "type": "number",
        "minimum": 0
      }
    },
    "required": [
      "id",
      "at",
      "day",
      "month",
      "model",
      "task",
      "status",
      "tokens"
    ],
    "additionalProperties": false
  },
  "PracticeSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "instructionVi": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "answerEn": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000
      },
      "explanationVi": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "category": {
        "type": "string",
        "enum": [
          "article",
          "tense_aspect",
          "preposition",
          "plural",
          "word_order",
          "agreement",
          "word_choice",
          "auxiliary",
          "spelling",
          "other"
        ]
      },
      "id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "unitId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "createdAt": {
        "type": "number",
        "minimum": 0
      },
      "completedAt": {
        "type": "number",
        "minimum": 0
      }
    },
    "required": [
      "instructionVi",
      "answerEn",
      "explanationVi",
      "category",
      "id",
      "unitId",
      "createdAt"
    ],
    "additionalProperties": false
  },
  "WeeklySchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "titleVi": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "textEn": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "meaningVi": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "coverage": {
        "minItems": 1,
        "maxItems": 8,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "unitId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "unitId",
            "quote"
          ],
          "additionalProperties": false
        }
      },
      "id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "week": {
        "type": "string",
        "maxLength": 20
      },
      "createdAt": {
        "type": "number",
        "minimum": 0
      }
    },
    "required": [
      "titleVi",
      "textEn",
      "meaningVi",
      "coverage",
      "id",
      "week",
      "createdAt"
    ],
    "additionalProperties": false
  },
  "DictionarySchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 150
      },
      "word": {
        "type": "string",
        "maxLength": 100
      },
      "checkedAt": {
        "type": "number",
        "minimum": 0
      },
      "status": {
        "type": "string",
        "enum": [
          "found",
          "not_found"
        ]
      },
      "phonetic": {
        "type": "string",
        "maxLength": 200
      },
      "definitions": {
        "maxItems": 8,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "partOfSpeech": {
              "type": "string",
              "maxLength": 100
            },
            "definition": {
              "type": "string",
              "maxLength": 3000
            },
            "example": {
              "type": "string",
              "maxLength": 3000
            }
          },
          "required": [
            "partOfSpeech",
            "definition"
          ],
          "additionalProperties": false
        }
      },
      "sources": {
        "maxItems": 10,
        "type": "array",
        "items": {
          "type": "string",
          "format": "uri"
        }
      },
      "license": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [
      "id",
      "word",
      "checkedAt",
      "status",
      "phonetic",
      "definitions",
      "sources",
      "license"
    ],
    "additionalProperties": false
  },
  "OptimizationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "at": {
        "type": "number",
        "minimum": 0
      },
      "reviews": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "trainingSamples": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "validationSamples": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "baselineLoss": {
        "type": "number"
      },
      "candidateLoss": {
        "type": "number"
      },
      "applied": {
        "type": "boolean"
      },
      "weights": {
        "minItems": 21,
        "maxItems": 21,
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "previousWeights": {
        "minItems": 21,
        "maxItems": 21,
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "noteVi": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "required": [
      "id",
      "at",
      "reviews",
      "trainingSamples",
      "validationSamples",
      "baselineLoss",
      "candidateLoss",
      "applied",
      "weights",
      "previousWeights",
      "noteVi"
    ],
    "additionalProperties": false
  }
}