{
  "name": "mach-doc",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs && node scripts/e2e-enrichment.mjs && node scripts/e2e-gemini.mjs && node scripts/e2e-organization.mjs",
    "test:e2e:enrichment": "node scripts/e2e-enrichment.mjs",
    "test:e2e:gemini": "node scripts/e2e-gemini.mjs",
    "check:text": "node scripts/check-text.mjs",
    "test:e2e:organization": "node scripts/e2e-organization.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-fsrs": "^5.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.56.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
