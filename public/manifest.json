{
  "manifest_version": 3,
  "name": "Mạch Đọc — Học từ ngữ cảnh",
  "description": "Lưu điều chưa hiểu khi đọc tiếng Anh, luyện viết và ôn đúng hạn. Dữ liệu nằm trên máy bạn.",
  "version": "0.2.3",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "unlimitedStorage",
    "offscreen",
    "downloads"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://www.youtube.com/api/timedtext*",
    "https://youtube.com/api/timedtext*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mạch Đọc — Mở góc học"
  },
  "options_page": "app.html#settings",
  "chrome_url_overrides": {
    "newtab": "app.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": [
        "video-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": [
        "video.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Lưu nhanh vùng chọn, phân tích sau"
    },
    "review": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Mở phần ôn tập"
    },
    "capture-video": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Lưu câu vừa nghe trên YouTube"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://generativelanguage.googleapis.com https://api.dictionaryapi.dev https://www.youtube.com https://youtube.com; frame-src https://www.youtube-nocookie.com; base-uri 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "video-editor.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
